generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdOrders   Order[]   @relation("OrderCreatedBy")
  ownedProjects   Project[] @relation("ProjectOwner")
  assignedTasks   Task[]    @relation("TaskAssignee")
  createdTasks    Task[]    @relation("TaskCreator")
  assignedTickets Ticket[]  @relation("TicketAssignee")
  createdTickets  Ticket[]  @relation("TicketCreator")
  auditLogs       AuditLog[]
  createdCmsContents Content[] @relation("CmsContentCreator")
  cmsRevisions ContentRevision[] @relation("CmsRevisionAuthor")

  @@index([role, isActive])
  @@map("users")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  sku         String        @unique
  description String?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  categoryId  String?       @db.Uuid
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@map("products")
}

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  email     String?        @unique
  phone     String?
  company   String?
  notes     String?
  status    CustomerStatus @default(ACTIVE)
  orders    Order[]
  tickets   Ticket[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
  @@map("customers")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  customerId  String      @db.Uuid
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById String?     @db.Uuid
  createdBy   User?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       OrderItem[]
  subtotal    Decimal     @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model Lead {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  company   String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("leads")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  ownerId     String?       @db.Uuid
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, dueDate])
  @@index([ownerId])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  projectId   String?      @db.Uuid
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId  String?      @db.Uuid
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?      @db.Uuid
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, priority, dueDate])
  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String
  status       TicketStatus @default(OPEN)
  priority     TaskPriority @default(MEDIUM)
  customerId   String?      @db.Uuid
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId String?      @db.Uuid
  assignedTo   User?        @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?      @db.Uuid
  createdBy    User?        @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, priority, createdAt])
  @@index([customerId])
  @@map("tickets")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}


enum LocaleDirection {
  LTR
  RTL
}

enum CmsFieldType {
  TEXT
  TEXTAREA
  RICH_TEXT
  MARKDOWN
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  SELECT
  MULTISELECT
  EMAIL
  URL
  JSON
}

enum CmsContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Locale {
  id               String                @id @default(uuid()) @db.Uuid
  code             String                @unique
  name             String
  nativeName       String
  direction        LocaleDirection       @default(LTR)
  isDefault        Boolean               @default(false)
  isActive         Boolean               @default(true)
  fallbackLocaleId String?               @db.Uuid
  fallbackLocale   Locale?               @relation("LocaleFallback", fields: [fallbackLocaleId], references: [id], onDelete: SetNull)
  fallbacks        Locale[]              @relation("LocaleFallback")
  translations     ContentTranslation[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([isActive, isDefault])
  @@index([fallbackLocaleId])
  @@map("locales")
}

model ContentType {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  name        String
  description String?
  isActive    Boolean            @default(true)
  fields      ContentTypeField[]
  contents    Content[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, createdAt])
  @@map("content_types")
}

model ContentTypeField {
  id            String      @id @default(uuid()) @db.Uuid
  contentTypeId String      @db.Uuid
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  key           String
  label         String
  type          CmsFieldType
  isRequired    Boolean     @default(false)
  isLocalized   Boolean     @default(true)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  config        Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([contentTypeId, key])
  @@index([contentTypeId, isActive, sortOrder])
  @@map("content_type_fields")
}

model Content {
  id            String               @id @default(uuid()) @db.Uuid
  contentTypeId String               @db.Uuid
  contentType   ContentType          @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  createdById   String?              @db.Uuid
  createdBy     User?                @relation("CmsContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  data          Json                 @default("{}")
  translations  ContentTranslation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([contentTypeId, createdAt])
  @@index([createdById])
  @@map("cms_contents")
}

model ContentTranslation {
  id                String           @id @default(uuid()) @db.Uuid
  contentId         String           @db.Uuid
  content           Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  localeId          String           @db.Uuid
  locale            Locale           @relation(fields: [localeId], references: [id], onDelete: Restrict)
  title             String
  slug              String
  excerpt           String?
  data              Json             @default("{}")
  seoTitle          String?
  seoDescription    String?
  status            CmsContentStatus @default(DRAFT)
  version           Int              @default(1)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  publishedSlug     String?
  publishedSnapshot Json?
  revisions         ContentRevision[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([contentId, localeId])
  @@unique([localeId, slug])
  @@unique([localeId, publishedSlug])
  @@index([localeId, status, updatedAt])
  @@index([status, scheduledAt])
  @@index([publishedAt])
  @@map("cms_content_translations")
}

model ContentRevision {
  id            String             @id @default(uuid()) @db.Uuid
  translationId String             @db.Uuid
  translation   ContentTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changeNote    String?
  createdById   String?            @db.Uuid
  createdBy     User?              @relation("CmsRevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  @@unique([translationId, version])
  @@index([translationId, createdAt])
  @@map("cms_content_revisions")
}
