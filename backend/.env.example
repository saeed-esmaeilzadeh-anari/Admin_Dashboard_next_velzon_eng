DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velzon_admin?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000"

# Used only by the seed command; do not commit actual credentials.
ADMIN_NAME="Dashboard Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Canonical public site URL used to generate absolute sitemap and hreflang links.
PUBLIC_SITE_URL="http://localhost:3000"

# Local media storage (ephemeral on serverless platforms unless mounted persistently)
UPLOAD_DIR=uploads
CMS_MAX_UPLOAD_BYTES=26214400


# Media storage defaults to local. Use "s3" only after configuring an S3-compatible bucket/public URL.
CMS_MEDIA_STORAGE=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Private bearer token for POST /api/v1/internal/cms/jobs/* (minimum 32 random characters).
# Required for external cron on serverless hosting; generate a unique secret outside source control.
CMS_JOB_TOKEN="replace-with-a-random-secret-at-least-32-characters-long"
